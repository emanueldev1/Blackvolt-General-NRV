diff --git a/lib/include/chiaki/vla.h b/lib/include/chiaki/vla.h
new file mode 100644
index 0000000..b11388e
--- /dev/null
+++ b/lib/include/chiaki/vla.h
@@ -0,0 +1,13 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+// Blackvolt: MSVC has no C99 variable length arrays. Same stack semantics via _alloca.
+#ifndef CHIAKI_VLA_H
+#define CHIAKI_VLA_H
+
+#ifdef _MSC_VER
+#include <malloc.h>
+#define CHIAKI_VLA(type, name, count) type *name = (type *)_alloca(sizeof(type) * (size_t)(count))
+#else
+#define CHIAKI_VLA(type, name, count) type name[count]
+#endif
+
+#endif // CHIAKI_VLA_H
diff --git a/lib/protobuf/CMakeLists.txt b/lib/protobuf/CMakeLists.txt
index 43fde68..483dcca 100644
--- a/lib/protobuf/CMakeLists.txt
+++ b/lib/protobuf/CMakeLists.txt
@@ -1,11 +1,19 @@
 
 find_program(PROTOC protoc)
-if(NOT PROTOC)
-	message(FATAL_ERROR "Could not find protoc")
+if(PROTOC)
+	set(PROTOC_COMMAND "${PROTOC}")
+else()
+	# Blackvolt: fall back to the protoc bundled with Python's grpcio-tools.
+	execute_process(COMMAND "${PYTHON_EXECUTABLE}" -c "import grpc_tools.protoc"
+		RESULT_VARIABLE GRPC_TOOLS_MISSING OUTPUT_QUIET ERROR_QUIET)
+	if(GRPC_TOOLS_MISSING)
+		message(FATAL_ERROR "Could not find protoc (install protoc or 'pip install grpcio-tools')")
+	endif()
+	set(PROTOC_COMMAND "${PYTHON_EXECUTABLE}" -m grpc_tools.protoc)
 endif()
 
 add_custom_command(OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/takion.pb"
-		COMMAND "${PROTOC}" "-o${CMAKE_CURRENT_BINARY_DIR}/takion.pb" "${CMAKE_CURRENT_SOURCE_DIR}/takion.proto" "-I${CMAKE_CURRENT_SOURCE_DIR}"
+		COMMAND ${PROTOC_COMMAND} "-o${CMAKE_CURRENT_BINARY_DIR}/takion.pb" "${CMAKE_CURRENT_SOURCE_DIR}/takion.proto" "-I${CMAKE_CURRENT_SOURCE_DIR}"
 		MAIN_DEPENDENCY "${CMAKE_CURRENT_SOURCE_DIR}/takion.proto")
 
 set(SOURCE_FILES "${CMAKE_CURRENT_BINARY_DIR}/takion.pb.c")
