<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Blackvolt.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Blackvolt">

  <Grid x:Name="Shell" Background="{StaticResource BvBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Title bar (draggable). The caption buttons are drawn by the system on the right. -->
    <Grid x:Name="TitleBar" Background="{StaticResource BvSurfaceBrush}" Padding="14,0,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="140" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Image Source="ms-appx:///Assets/Logo-64.png" Width="20" Height="20" />
        <TextBlock Text="Blackvolt" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
        <Border Style="{StaticResource BvBadgeStyle}" VerticalAlignment="Center" Padding="7,1,7,2">
          <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource BvMutedBrush}" />
        </Border>
      </StackPanel>
      <TextBlock x:Name="PageCrumb" Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" FontSize="12"
                 Foreground="{StaticResource BvSubtleBrush}" />
      <!-- Background installs and updates -->
      <StackPanel x:Name="ActivityChip" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                  Visibility="Collapsed" Margin="0,0,10,0">
        <ProgressRing x:Name="ActivityRing" Width="14" Height="14" IsActive="True" />
        <TextBlock x:Name="ActivityText" FontSize="12" Foreground="{StaticResource BvMutedBrush}" MaxWidth="320"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>
    <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Fill="{StaticResource BvBorderBrush}" />

    <NavigationView x:Name="Nav" Grid.Row="1"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="True"
                    PaneDisplayMode="Left"
                    OpenPaneLength="244"
                    CompactModeThresholdWidth="900"
                    ExpandedModeThresholdWidth="1100"
                    IsTitleBarAutoPaddingEnabled="False"
                    PaneOpening="OnPaneChanged" PaneClosing="OnPaneChanged"
                    SelectionChanged="OnNavSelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItemHeader Content="REPRODUCIR" FontSize="11" />
        <NavigationViewItem Content="Inicio" Tag="home" IsSelected="True">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Reproductor" Tag="player">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE768;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="PlayStation" Tag="remote">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE7FC;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Captura" Tag="capture">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE714;" /></NavigationViewItem.Icon>
        </NavigationViewItem>

        <NavigationViewItemHeader Content="HERRAMIENTAS" FontSize="11" />
        <NavigationViewItem Content="Exportar" Tag="export">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE898;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Rendimiento" Tag="stats">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Runtimes NVIDIA" Tag="runtimes">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE964;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <NavigationView.PaneFooter>
        <!-- GPU and runtime status, always in sight -->
        <Border x:Name="GpuCard" Margin="10,6,10,10" Padding="12,10" CornerRadius="10"
                Background="{StaticResource BvSurface2Brush}" BorderBrush="{StaticResource BvBorderBrush}" BorderThickness="1">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse x:Name="GpuDot" Width="8" Height="8" Fill="{StaticResource BvSuccessBrush}" VerticalAlignment="Center" />
              <TextBlock x:Name="GpuName" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="180" />
            </StackPanel>
            <StackPanel x:Name="RuntimeChips" Orientation="Horizontal" Spacing="5" />
          </StackPanel>
        </Border>
      </NavigationView.PaneFooter>

      <Frame x:Name="ContentFrame" />
    </NavigationView>

    <!-- Toasts (bottom right): installs, screenshots, errors -->
    <StackPanel x:Name="ToastHost" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,20,20" Spacing="8" MaxWidth="420" />
  </Grid>
</Window>
