<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Blackvolt.App</RootNamespace>
    <AssemblyName>Blackvolt</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationIcon>Assets\Blackvolt.ico</ApplicationIcon>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Product>Blackvolt</Product>
    <Authors>Emanuel</Authors>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\*.png;Assets\*.ico" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>

  <!-- Ship the native engine next to Blackvolt.exe. Build it first with: the CMake preset "windows-x64" (see README) -->
  <PropertyGroup>
    <EngineBinDir>$(MSBuildThisFileDirectory)..\..\build\engine\bin\$(Configuration)\</EngineBinDir>
  </PropertyGroup>
  <!-- Runtime manifest and, when present, the NVIDIA DLLs fetched by scripts/fetch-sdks.ps1. -->
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)..\..\</RepoRoot>
    <DlssRelDir>$(RepoRoot)third_party\sdk\dlss\lib\Windows_x86_64\rel\</DlssRelDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(RepoRoot)runtime\manifest.json" Link="runtime\manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(DlssRelDir)*.dll" Condition="Exists('$(DlssRelDir)')" Link="runtime\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine and everything it loads (FFmpeg, OpenSSL, Opus, SDL3...), placed there by vcpkg. -->
    <None Include="$(EngineBinDir)*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
