<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Blackvolt.App.Views.CapturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel Padding="36,28" Spacing="22" MaxWidth="900" HorizontalAlignment="Left">

      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="4">
          <TextBlock Text="Captura" Style="{StaticResource TitleLargeTextBlockStyle}" />
          <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="640"
                     Text="Mira tu consola, cámara o capturadora con la menor latencia posible, con Super Resolution y TrueHDR si tu GPU los soporta." />
        </StackPanel>
        <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnRefresh">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE72C;" FontSize="14" />
            <TextBlock Text="Actualizar" />
          </StackPanel>
        </Button>
      </Grid>

      <InfoBar x:Name="Notice" IsOpen="False" />

      <Border x:Name="EmptyCard" Style="{StaticResource BvCardStyle}" Padding="24" Visibility="Collapsed">
        <StackPanel Spacing="6">
          <TextBlock Text="No se encontraron dispositivos de video" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     Text="Conecta la capturadora o la cámara y pulsa Actualizar. Si es una capturadora con software propio, ciérralo antes: Windows solo deja que una app use el dispositivo." />
        </StackPanel>
      </Border>

      <Border x:Name="SetupCard" Style="{StaticResource BvCardStyle}" Padding="24">
        <Grid RowSpacing="18" ColumnSpacing="20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <ComboBox x:Name="VideoDevices" Header="Video" HorizontalAlignment="Stretch" />
          <ComboBox x:Name="AudioDevices" Grid.Column="1" Header="Audio" HorizontalAlignment="Stretch" />

          <ComboBox x:Name="Resolution" Grid.Row="1" Header="Resolución" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="La del dispositivo" Tag="0" />
            <ComboBoxItem Content="720p" Tag="720" />
            <ComboBoxItem Content="1080p" Tag="1080" />
            <ComboBoxItem Content="1440p" Tag="1440" />
            <ComboBoxItem Content="2160p (4K)" Tag="2160" />
          </ComboBox>
          <ComboBox x:Name="FrameRate" Grid.Row="1" Grid.Column="1" Header="Fotogramas por segundo" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="Los del dispositivo" Tag="0" />
            <ComboBoxItem Content="30" Tag="30" />
            <ComboBoxItem Content="60" Tag="60" />
            <ComboBoxItem Content="120" Tag="120" />
          </ComboBox>

          <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12">
            <Button x:Name="StartButton" Click="OnStart" Style="{StaticResource AccentButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE768;" FontSize="14" />
                <TextBlock Text="Ver en vivo" />
              </StackPanel>
            </Button>
            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Si la imagen no aparece, prueba con la resolución y fps del dispositivo." TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Screen / window capture (gdigrab) -->
      <Border Style="{StaticResource BvCardStyle}" Padding="24">
        <Grid RowSpacing="18" ColumnSpacing="20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.ColumnSpan="2" Spacing="4">
            <TextBlock Text="Pantalla y ventanas" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Mira un monitor o una ventana (un reproductor web, un emulador) con las mismas mejoras: DLSS NR, superresolución, fluidez de movimiento. No captures la propia ventana de Blackvolt." />
          </StackPanel>
          <ComboBox x:Name="ScreenSources" Grid.Row="1" Header="Fuente" HorizontalAlignment="Stretch" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="16">
            <ComboBox x:Name="ScreenFps" Header="FPS" MinWidth="110">
              <ComboBoxItem Content="30" Tag="30" />
              <ComboBoxItem Content="60" Tag="60" />
              <ComboBoxItem Content="120" Tag="120" />
            </ComboBox>
            <ToggleSwitch x:Name="ScreenCursor" Header="Mostrar el cursor" OnContent="Sí" OffContent="No" IsOn="True" />
          </StackPanel>
          <Button Grid.Row="2" Click="OnStartScreen" Style="{StaticResource AccentButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE7F4;" FontSize="14" />
              <TextBlock Text="Ver pantalla" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
