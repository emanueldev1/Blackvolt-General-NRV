<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Blackvolt.App.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
    KeyboardAcceleratorPlacementMode="Hidden">

  <Page.KeyboardAccelerators>
    <KeyboardAccelerator Key="Space" Invoked="OnTogglePlay" />
    <KeyboardAccelerator Key="K" Invoked="OnTogglePlay" />
    <KeyboardAccelerator Key="Left" Invoked="OnSeekBack" />
    <KeyboardAccelerator Key="Right" Invoked="OnSeekForward" />
    <KeyboardAccelerator Key="I" Invoked="OnToggleStats" />
    <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnOpenAccel" />
  </Page.KeyboardAccelerators>

  <Grid Background="Black" PointerMoved="OnPointerMoved">
    <SwapChainPanel x:Name="Video" SizeChanged="OnVideoSizeChanged"
                    CompositionScaleChanged="OnCompositionScaleChanged" />

    <!-- Empty state -->
    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
      <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center"
              BorderBrush="{StaticResource BvVoltBrush}" BorderThickness="1.5">
        <FontIcon Glyph="&#xE768;" FontSize="26" Foreground="{StaticResource BvVoltBrush}" />
      </Border>
      <TextBlock Text="Suelta un video aquí" HorizontalAlignment="Center"
                 Style="{StaticResource SubtitleTextBlockStyle}" Foreground="White" />
      <TextBlock Text="o pulsa Ctrl+O para abrir uno" HorizontalAlignment="Center" Foreground="#99FFFFFF" />
      <Button Content="Abrir archivo" HorizontalAlignment="Center" Click="OnOpen"
              Style="{StaticResource AccentButtonStyle}" Margin="0,6,0,0" />
    </StackPanel>

    <!-- Stats overlay -->
    <Border x:Name="StatsPanel" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="16" Padding="14,10" CornerRadius="6" Background="#B3000000">
      <TextBlock x:Name="StatsText" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 Foreground="#E6FFFFFF" LineHeight="18" />
    </Border>

    <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" VerticalAlignment="Top" Margin="16" MaxWidth="640" />

    <!-- Transport -->
    <Grid x:Name="Transport" VerticalAlignment="Bottom" Padding="20,40,20,14" Visibility="Collapsed">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#00000000" Offset="0" />
          <GradientStop Color="#CC000000" Offset="1" />
        </LinearGradientBrush>
      </Grid.Background>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Slider x:Name="Timeline" Minimum="0" StepFrequency="0.01" IsThumbToolTipEnabled="False"
              ValueChanged="OnTimelineChanged" PointerCaptureLost="OnTimelineReleased" />

      <Grid Grid.Row="1" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="PlayButton" Click="OnPlayClick" Width="44" Height="36" Background="Transparent"
                BorderThickness="0" ToolTipService.ToolTip="Reproducir / pausa (Espacio)">
          <FontIcon x:Name="PlayIcon" Glyph="&#xE769;" Foreground="White" />
        </Button>
        <TextBlock x:Name="TimeText" Grid.Column="1" VerticalAlignment="Center" Foreground="White"
                   FontFamily="Cascadia Mono, Consolas" FontSize="13" Text="0:00 / 0:00" />
        <TextBlock x:Name="SourceText" Grid.Column="2" VerticalAlignment="Center" Foreground="#99FFFFFF"
                   TextTrimming="CharacterEllipsis" Margin="12,0" />
        <FontIcon Grid.Column="3" Glyph="&#xE767;" Foreground="White" FontSize="14" />
        <Slider x:Name="Volume" Grid.Column="4" Width="110" Minimum="0" Maximum="100" Value="100"
                VerticalAlignment="Center" ValueChanged="OnVolumeChanged" />
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
          <Button Click="OnToggleStatsClick" Background="Transparent" BorderThickness="0"
                  ToolTipService.ToolTip="Estadísticas (I)">
            <FontIcon Glyph="&#xE9D9;" Foreground="White" FontSize="14" />
          </Button>
          <Button Click="OnOpen" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Abrir (Ctrl+O)">
            <FontIcon Glyph="&#xE8E5;" Foreground="White" FontSize="14" />
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Page>
