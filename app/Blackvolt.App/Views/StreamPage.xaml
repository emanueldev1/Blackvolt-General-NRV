<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Blackvolt.App.Views.StreamPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    KeyboardAcceleratorPlacementMode="Hidden">

  <Grid x:Name="Root" Background="Black" IsTabStop="True" PointerMoved="OnPointerMoved"
        KeyDown="OnKeyDown" KeyUp="OnKeyUp" DoubleTapped="OnDoubleTapped">
    <SwapChainPanel x:Name="Video" SizeChanged="OnVideoSizeChanged"
                    CompositionScaleChanged="OnCompositionScaleChanged" />

    <!-- Connecting / reconnecting / error -->
    <Border x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520"
            Style="{StaticResource BvPanelStyle}" Padding="32,28">
      <StackPanel Spacing="14">
        <ProgressRing x:Name="StatusRing" IsActive="True" Width="40" Height="40" />
        <TextBlock x:Name="StatusTitle" Text="Conectando…" HorizontalAlignment="Center" Foreground="White"
                   FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="StatusDetail" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{StaticResource BvMutedBrush}" />
        <StackPanel x:Name="StatusActions" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                    Visibility="Collapsed" Margin="0,6,0,0">
          <Button Content="Reintentar" Click="OnRetry" Style="{StaticResource BvPrimaryButtonStyle}" />
          <Button Content="Volver" Click="OnBack" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Live stats -->
    <Border x:Name="StatsPanel" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="16,76,16,16" IsHitTestVisible="False" />

    <!-- "Locked" / "showing original" hints -->
    <Border x:Name="HintPill" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
            Style="{StaticResource BvPanelStyle}" CornerRadius="999" Padding="16,8" Visibility="Collapsed"
            IsHitTestVisible="False">
      <TextBlock x:Name="HintText" Foreground="White" FontSize="13" />
    </Border>

    <!-- Top bar: a floating pill that auto-hides while playing -->
    <Grid x:Name="TopBar" VerticalAlignment="Top" Margin="12,12,12,0" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource BvPanelStyle}" CornerRadius="14" Padding="6">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Click="OnBack" Style="{StaticResource BvOverlayButtonStyle}" ToolTipService.ToolTip="Desconectar y volver">
            <FontIcon Glyph="&#xE72B;" FontSize="13" />
          </Button>
          <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock x:Name="ConsoleName" Foreground="White" FontWeight="SemiBold" FontSize="13" />
            <TextBlock x:Name="PadText" Foreground="{StaticResource BvMutedBrush}" FontSize="11.5" />
          </StackPanel>
          <Border x:Name="QualityChip" Background="{StaticResource BvPrimarySoftBrush}" CornerRadius="999" Padding="10,3,10,4"
                  VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,6,0">
            <TextBlock x:Name="QualityText" Foreground="#FFB9D2FF" FontSize="12" FontWeight="SemiBold" />
          </Border>
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource BvPanelStyle}" CornerRadius="14" Padding="6">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button x:Name="EnhanceButton" Click="OnToggleSheet" Style="{StaticResource BvOverlayButtonStyle}"
                  ToolTipService.ToolTip="Panel rápido: NR, VSR, HDR, fluidez, color… (Inicio)">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE790;" FontSize="14" />
              <TextBlock Text="Mejoras" FontSize="13" />
            </StackPanel>
          </Button>
          <Button Click="OnPsButton" Style="{StaticResource BvOverlayButtonStyle}" ToolTipService.ToolTip="Botón PS (P)">
            <FontIcon Glyph="&#xE80F;" FontSize="14" />
          </Button>
          <Button Click="OnToggleStatsClick" Style="{StaticResource BvOverlayButtonStyle}" ToolTipService.ToolTip="Estadísticas (F3)">
            <FontIcon Glyph="&#xE9D9;" FontSize="14" />
          </Button>
          <Border Background="#14FFFFFF" CornerRadius="10" Padding="10,0" BorderBrush="#1FFFFFFF" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <FontIcon Glyph="&#xE767;" FontSize="13" Foreground="White" VerticalAlignment="Center" />
              <Slider x:Name="Volume" Width="92" Minimum="0" Maximum="100" VerticalAlignment="Center"
                      ValueChanged="OnVolumeChanged" />
            </StackPanel>
          </Border>
          <Button Click="OnFullscreen" Style="{StaticResource BvOverlayButtonStyle}" ToolTipService.ToolTip="Pantalla completa (F11)">
            <FontIcon x:Name="FullscreenIcon" Glyph="&#xE740;" FontSize="14" />
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Page>
