<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Blackvolt.App.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Blackvolt.App.Views">
  <ScrollViewer>
  <StackPanel Padding="36,28" Spacing="20">
    <StackPanel Spacing="4">
      <TextBlock Text="Estadísticas" Style="{StaticResource TitleLargeTextBlockStyle}" />
      <TextBlock Text="Tiempo por etapa del pipeline (últimos ~4 s). Se actualiza dos veces por segundo."
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>

    <!-- Live: frame-time graph, FPS / 1 % low, VRAM -->
    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource BvCardStyle}">
        <StackPanel Spacing="8">
          <Grid>
            <TextBlock Text="TIEMPO DE FOTOGRAMA (últimos ~4 s)" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Name="GraphScale" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}"
                       FontFamily="Cascadia Mono, Consolas" />
          </Grid>
          <Grid x:Name="GraphHost" Height="140" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <Canvas x:Name="GraphCanvas">
              <Polyline x:Name="GpuLine" Stroke="#FF50A0FF" StrokeThickness="1.3" />
              <Polyline x:Name="FrameLine" Stroke="{StaticResource BvVoltBrush}" StrokeThickness="1.6" />
            </Canvas>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="16">
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"><Run Text="■ " Foreground="{StaticResource BvVoltBrush}" />Intervalo entre fotogramas</TextBlock>
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"><Run Text="■ " Foreground="#FF50A0FF" />Tiempo de GPU</TextBlock>
          </StackPanel>
        </StackPanel>
      </Border>
      <StackPanel Grid.Column="1" Spacing="12" Width="220">
        <Border Style="{StaticResource BvCardStyle}">
          <StackPanel>
            <TextBlock Text="FPS · 1% BAJO" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Name="LiveFps" Text="–" Style="{StaticResource BvMetricValueStyle}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource BvCardStyle}">
          <StackPanel Spacing="6">
            <TextBlock Text="VRAM DEL PROCESO" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Name="LiveVram" Text="–" Style="{StaticResource BvMetricValueStyle}" FontSize="20" />
            <ProgressBar x:Name="VramBar" Maximum="1" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <ItemsControl x:Name="StageList">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="local:StageRow">
          <Border Style="{StaticResource BvCardStyle}" Margin="0,0,0,12">
            <Grid ColumnSpacing="24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyStrongTextBlockStyle}"
                         VerticalAlignment="Center" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="PROMEDIO" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Text="{x:Bind Avg}" Style="{StaticResource BvMetricValueStyle}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="P95" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Text="{x:Bind P95}" Style="{StaticResource BvMetricValueStyle}" />
              </StackPanel>
              <StackPanel Grid.Column="3">
                <TextBlock Text="P99" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Text="{x:Bind P99}" Style="{StaticResource BvMetricValueStyle}" />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="MÁXIMO" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Text="{x:Bind Max}" Style="{StaticResource BvMetricValueStyle}" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock x:Name="EmptyHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
               Text="Aún no hay datos. Reproduce o captura un video para ver las métricas." />
    <Grid Margin="0,20,0,0" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="4">
        <TextBlock Text="Historial" Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock Text="Resumen de cada sesión de más de 5 segundos: reproducción, captura, Remote Play y exportaciones."
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
      </StackPanel>
      <Button x:Name="ClearButton" Grid.Column="1" VerticalAlignment="Bottom" Content="Borrar historial" Click="OnClearHistory" />
    </Grid>

    <Grid x:Name="SummaryGrid" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource BvCardStyle}">
        <StackPanel>
          <TextBlock Text="SESIONES" Style="{StaticResource CaptionTextBlockStyle}" />
          <TextBlock x:Name="SumSessions" Style="{StaticResource BvMetricValueStyle}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource BvCardStyle}">
        <StackPanel>
          <TextBlock Text="TIEMPO TOTAL" Style="{StaticResource CaptionTextBlockStyle}" />
          <TextBlock x:Name="SumTime" Style="{StaticResource BvMetricValueStyle}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource BvCardStyle}">
        <StackPanel>
          <TextBlock Text="FPS MEDIOS" Style="{StaticResource CaptionTextBlockStyle}" />
          <TextBlock x:Name="SumFps" Style="{StaticResource BvMetricValueStyle}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Style="{StaticResource BvCardStyle}">
        <StackPanel>
          <TextBlock Text="FOTOGRAMAS PERDIDOS" Style="{StaticResource CaptionTextBlockStyle}" />
          <TextBlock x:Name="SumDropped" Style="{StaticResource BvMetricValueStyle}" />
        </StackPanel>
      </Border>
    </Grid>

    <ItemsControl x:Name="HistoryList">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="local:HistoryRow">
          <Border Style="{StaticResource BvCardStyle}" Margin="0,0,0,8" Padding="16,12">
            <Grid ColumnSpacing="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="90" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Kind}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{x:Bind When}" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="DURACIÓN" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Text="{x:Bind Duration}" FontFamily="Cascadia Mono, Consolas" />
              </StackPanel>
              <StackPanel Grid.Column="3">
                <TextBlock Text="RESOLUCIÓN" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Text="{x:Bind Resolution}" FontFamily="Cascadia Mono, Consolas" />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="FPS" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Text="{x:Bind Fps}" FontFamily="Cascadia Mono, Consolas" />
              </StackPanel>
              <StackPanel Grid.Column="5">
                <TextBlock Text="{x:Bind TailLabel}" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Text="{x:Bind Tail}" FontFamily="Cascadia Mono, Consolas" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock x:Name="HistoryEmpty" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
               Text="Todavía no hay sesiones guardadas." />
  </StackPanel>
  </ScrollViewer>
</Page>
