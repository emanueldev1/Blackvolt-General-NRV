<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Blackvolt.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
  <StackPanel Padding="32,28" Spacing="18" MaxWidth="900" HorizontalAlignment="Left">
    <StackPanel Spacing="4">
      <TextBlock Text="Ajustes" Style="{StaticResource BvPageTitleStyle}" />
      <TextBlock Text="Interfaz, GPU, actualizaciones y diagnóstico. Las mejoras de imagen se ajustan en el panel rápido (tecla Inicio) mientras ves algo."
                 Style="{StaticResource BvMutedTextStyle}" />
    </StackPanel>

    <!-- Interface -->
    <Border Style="{StaticResource BvCardStyle}">
      <StackPanel Spacing="12">
        <TextBlock Text="Interfaz" Style="{StaticResource BvSectionTitleStyle}" />
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="StartPageBox" Header="Al abrir Blackvolt" HorizontalAlignment="Stretch" SelectionChanged="OnStartPageChanged" />
          <ComboBox x:Name="AutoHideBox" Grid.Column="1" Header="Ocultar controles y cursor sobre el vídeo" HorizontalAlignment="Stretch"
                    SelectionChanged="OnAutoHideChanged" />
        </Grid>
        <ToggleSwitch x:Name="RememberWindowSwitch" Header="Recordar tamaño y posición de la ventana" OnContent="Sí" OffContent="No"
                      Toggled="OnRememberWindowToggled" />
        <ToggleSwitch x:Name="ReduceMotionSwitch" Header="Reducir animaciones" OnContent="Sí" OffContent="No"
                      Toggled="OnReduceMotionToggled" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource BvCardStyle}">
      <StackPanel Spacing="8">
        <TextBlock Text="GPUs detectadas" Style="{StaticResource BvSectionTitleStyle}" />
        <TextBlock Text="Blackvolt elige automáticamente la mejor GPU (NVIDIA RTX primero)."
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <ListView x:Name="AdapterList" SelectionMode="None" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource BvCardStyle}">
      <StackPanel Spacing="12">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="4">
            <TextBlock Text="Actualizaciones" Style="{StaticResource BvSectionTitleStyle}" />
            <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <Button x:Name="CheckButton" Grid.Column="1" VerticalAlignment="Center" Click="OnCheckUpdates">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE895;" FontSize="14" />
              <TextBlock Text="Buscar actualizaciones" />
            </StackPanel>
          </Button>
        </Grid>

        <ToggleSwitch x:Name="AutoCheckSwitch" Header="Buscar actualizaciones al iniciar"
                      OnContent="Sí" OffContent="No" Toggled="OnAutoCheckToggled" />

        <ComboBox x:Name="MirrorBox" Header="Servidor de descarga (actualizaciones y runtimes NVIDIA)" MinWidth="260"
                  SelectionChanged="OnMirrorChanged" />
        <ToggleSwitch x:Name="NrAutoSwitch" Header="Instalar DLSS NR, RTX VSR y TrueHDR automáticamente en GPUs RTX"
                      OnContent="Sí" OffContent="No" Toggled="OnNrAutoToggled" />
        <ToggleSwitch x:Name="ResumeSwitch" Header="Al abrir el Reproductor, retomar la última fuente (archivo en su posición, o captura)"
                      OnContent="Sí" OffContent="No" Toggled="OnResumeToggled" />

        <StackPanel x:Name="UpdatePanel" Spacing="10" Visibility="Collapsed">
          <TextBlock x:Name="UpdateTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
          <ScrollViewer MaxHeight="220">
            <TextBlock x:Name="UpdateNotes" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </ScrollViewer>
          <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="1" Visibility="Collapsed" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="InstallButton" Click="OnInstallUpdate" Style="{StaticResource AccentButtonStyle}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE896;" FontSize="14" />
                <TextBlock Text="Descargar e instalar" />
              </StackPanel>
            </Button>
            <Button x:Name="SkipButton" Content="Omitir esta versión" Click="OnSkipUpdate" />
            <HyperlinkButton x:Name="ReleaseLink" Content="Ver en GitHub" />
          </StackPanel>
          <TextBlock Text="Blackvolt se cerrará, copiará la nueva versión y se volverá a abrir. Tus ajustes y consolas se conservan."
                     TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <InfoBar x:Name="UpdateNotice" IsOpen="False" />
      </StackPanel>
    </Border>

    <!-- Diagnostics -->
    <Border Style="{StaticResource BvCardStyle}">
      <StackPanel Spacing="10">
        <TextBlock Text="Diagnóstico" Style="{StaticResource BvSectionTitleStyle}" />
        <TextBlock Text="Si algo falla, el registro del motor (engine.log) y el de errores (crash.log) dicen qué pasó. Copia el diagnóstico y pégalo en tu reporte."
                   Style="{StaticResource BvMutedTextStyle}" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Click="OnOpenLogs">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE838;" FontSize="14" />
              <TextBlock Text="Abrir carpeta de registros" />
            </StackPanel>
          </Button>
          <Button Click="OnCopyDiagnostics">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE8C8;" FontSize="14" />
              <TextBlock Text="Copiar diagnóstico" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
  </ScrollViewer>
</Page>
