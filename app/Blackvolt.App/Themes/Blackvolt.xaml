<?xml version="1.0" encoding="utf-8"?>
<!--
  Blackvolt design system: near-black zinc surfaces, hairline borders, blue primary and a
  blue → cyan brand gradient (shadcn/ui look). The app always runs in the dark theme.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="SystemAccentColor">#FF3B82F6</Color>
      <Color x:Key="SystemAccentColorLight1">#FF5B9BFF</Color>
      <Color x:Key="SystemAccentColorLight2">#FF7FB2FF</Color>
      <Color x:Key="SystemAccentColorLight3">#FFA6CAFF</Color>
      <Color x:Key="SystemAccentColorDark1">#FF2563EB</Color>
      <Color x:Key="SystemAccentColorDark2">#FF1D4ED8</Color>
      <Color x:Key="SystemAccentColorDark3">#FF1E40AF</Color>

      <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FF07080C" />
      <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF07080C" />

      <!-- Cards and layers -->
      <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF0C0E14" />
      <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FF0A0C11" />
      <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF1E2330" />
      <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FF0A0C11" />
      <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" Color="#FF0A0C11" />
      <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#FF1E2330" />
      <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#FF1A1E29" />

      <!-- Controls: outline style -->
      <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF10131A" />
      <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF161A23" />
      <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FF0D1016" />
      <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FF0A0C11" />
      <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FF242A38" />
      <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#FF2A3142" />
      <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#FF242A38" />
      <SolidColorBrush x:Key="CircleElevationBorderBrush" Color="#FF242A38" />
      <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#FF131722" />
      <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#FF181C26" />

      <!-- Text -->
      <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFF4F6FB" />
      <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF8B93A7" />
      <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF5D6578" />

      <!-- Navigation -->
      <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FF0A0C11" />
      <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FF0A0C11" />
      <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#FF0A0C11" />
      <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FF07080C" />
      <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#FF1A1E29" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#FF151A26" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#FF1A2030" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#FF11141C" />
      <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FF3B82F6" />

      <!-- Flyouts / menus / tooltips -->
      <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FF0C0E14" />
      <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#FF242A38" />
      <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FF0C0E14" />
      <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#FF242A38" />
      <SolidColorBrush x:Key="ToolTipBackground" Color="#FF12151D" />
      <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#FF2A3142" />
      <SolidColorBrush x:Key="AcrylicInAppFillColorDefaultBrush" Color="#F00C0E14" />
      <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#F00C0E14" />
      <SolidColorBrush x:Key="ContentDialogBackground" Color="#FF0C0E14" />
      <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#FF242A38" />

      <!-- Accent (primary) buttons: solid blue, white text -->
      <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF3B82F6" />
      <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF5B9BFF" />
      <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF2563EB" />
      <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#FF1E2638" />
      <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />
      <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#FF5D6578" />
      <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="#FF4C8DF8" />
      <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF7FB2FF" />
      <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FF7FB2FF" />
      <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FF5B9BFF" />
      <SolidColorBrush x:Key="NavigationViewItemHeaderForeground" Color="#FF5D6578" />

      <!-- Toggles and sliders in the brand blue -->
      <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF3B82F6" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF5B9BFF" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF2563EB" />
      <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#FF161A23" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#FF2F3647" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- ===================================================================== palette -->
  <Color x:Key="BvBackgroundColor">#FF07080C</Color>   <!-- window -->
  <Color x:Key="BvSurfaceColor">#FF0C0E14</Color>      <!-- sidebar, cards -->
  <Color x:Key="BvSurface2Color">#FF12151D</Color>     <!-- inputs, hovered rows -->
  <Color x:Key="BvSurface3Color">#FF181C26</Color>     <!-- pressed, active nav -->
  <Color x:Key="BvBorderColor">#FF1E2330</Color>       <!-- hairlines -->
  <Color x:Key="BvBorderStrongColor">#FF2A3142</Color>
  <Color x:Key="BvForegroundColor">#FFF4F6FB</Color>
  <Color x:Key="BvMutedColor">#FF8B93A7</Color>
  <Color x:Key="BvSubtleColor">#FF5D6578</Color>
  <Color x:Key="BvPrimaryColor">#FF3B82F6</Color>      <!-- blue-500 -->
  <Color x:Key="BvPrimaryHoverColor">#FF5B9BFF</Color>
  <Color x:Key="BvPrimaryPressedColor">#FF2563EB</Color>
  <Color x:Key="BvCyanColor">#FF22D3EE</Color>
  <Color x:Key="BvSuccessColor">#FF34D399</Color>
  <Color x:Key="BvWarningColor">#FFFBBF24</Color>
  <Color x:Key="BvDangerColor">#FFF87171</Color>

  <SolidColorBrush x:Key="BvBackgroundBrush" Color="{StaticResource BvBackgroundColor}" />
  <SolidColorBrush x:Key="BvSurfaceBrush" Color="{StaticResource BvSurfaceColor}" />
  <SolidColorBrush x:Key="BvSurface2Brush" Color="{StaticResource BvSurface2Color}" />
  <SolidColorBrush x:Key="BvSurface3Brush" Color="{StaticResource BvSurface3Color}" />
  <SolidColorBrush x:Key="BvBorderBrush" Color="{StaticResource BvBorderColor}" />
  <SolidColorBrush x:Key="BvBorderStrongBrush" Color="{StaticResource BvBorderStrongColor}" />
  <SolidColorBrush x:Key="BvForegroundBrush" Color="{StaticResource BvForegroundColor}" />
  <SolidColorBrush x:Key="BvMutedBrush" Color="{StaticResource BvMutedColor}" />
  <SolidColorBrush x:Key="BvSubtleBrush" Color="{StaticResource BvSubtleColor}" />
  <SolidColorBrush x:Key="BvPrimaryBrush" Color="{StaticResource BvPrimaryColor}" />
  <SolidColorBrush x:Key="BvPrimarySoftBrush" Color="#263B82F6" />
  <SolidColorBrush x:Key="BvCyanBrush" Color="{StaticResource BvCyanColor}" />
  <SolidColorBrush x:Key="BvSuccessBrush" Color="{StaticResource BvSuccessColor}" />
  <SolidColorBrush x:Key="BvSuccessSoftBrush" Color="#2234D399" />
  <SolidColorBrush x:Key="BvWarningBrush" Color="{StaticResource BvWarningColor}" />
  <SolidColorBrush x:Key="BvWarningSoftBrush" Color="#22FBBF24" />
  <SolidColorBrush x:Key="BvDangerBrush" Color="{StaticResource BvDangerColor}" />
  <SolidColorBrush x:Key="BvDangerSoftBrush" Color="#22F87171" />
  <SolidColorBrush x:Key="BvOverlayBrush" Color="#E60A0C12" />       <!-- floating panels over video -->
  <SolidColorBrush x:Key="BvScrimBrush" Color="#99000000" />

  <!-- Old names, kept so every page picks up the new accent. -->
  <Color x:Key="BvVoltColor">#FF3B82F6</Color>
  <Color x:Key="BvVoltDimColor">#263B82F6</Color>
  <SolidColorBrush x:Key="BvVoltBrush" Color="#FF5B9BFF" />
  <SolidColorBrush x:Key="BvVoltDimBrush" Color="#263B82F6" />

  <LinearGradientBrush x:Key="BvBrandGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF2563EB" Offset="0" />
    <GradientStop Color="#FF3B82F6" Offset="0.45" />
    <GradientStop Color="#FF22D3EE" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="BvHeroGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF0E1B3A" Offset="0" />
    <GradientStop Color="#FF0B1226" Offset="0.55" />
    <GradientStop Color="#FF071A22" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="BvGlowGradient" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#003B82F6" Offset="0" />
    <GradientStop Color="#663B82F6" Offset="0.5" />
    <GradientStop Color="#0022D3EE" Offset="1" />
  </LinearGradientBrush>

  <!-- ===================================================================== WinUI overrides -->
  <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>


  <!-- ===================================================================== text -->
  <Style x:Key="BvDisplayTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="34" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CharacterSpacing" Value="-20" />
    <Setter Property="Foreground" Value="{StaticResource BvForegroundBrush}" />
  </Style>
  <Style x:Key="BvPageTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CharacterSpacing" Value="-15" />
    <Setter Property="Foreground" Value="{StaticResource BvForegroundBrush}" />
  </Style>
  <Style x:Key="BvSectionTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource BvForegroundBrush}" />
  </Style>
  <Style x:Key="BvMutedTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource BvMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="BvLabelTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CharacterSpacing" Value="80" />
    <Setter Property="Foreground" Value="{StaticResource BvSubtleBrush}" />
  </Style>
  <Style x:Key="BvMetricValueStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
  </Style>

  <!-- ===================================================================== surfaces -->
  <Style x:Key="BvCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BvSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BvBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style x:Key="BvPanelStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BvOverlayBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BvBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style x:Key="BvChipStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BvPrimarySoftBrush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="Margin" Value="0,0,8,8" />
  </Style>
  <Style x:Key="BvBadgeStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BvSurface2Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BvBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="9,2,9,3" />
  </Style>

  <!-- ===================================================================== buttons -->
  <!-- Outline (shadcn "outline" / "secondary"): the default Button already maps to it through the overrides above. -->
  <Style x:Key="BvGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style x:Key="BvIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="MinWidth" Value="36" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style x:Key="BvOverlayButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="#14FFFFFF" />
    <Setter Property="BorderBrush" Value="#1FFFFFFF" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Padding" Value="9" />
    <Setter Property="MinWidth" Value="38" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style x:Key="BvPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="Padding" Value="14,7" />
  </Style>

  <!-- Source tile on the home page -->
  <Style x:Key="BvTileButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="{StaticResource BvSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BvBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
</ResourceDictionary>
